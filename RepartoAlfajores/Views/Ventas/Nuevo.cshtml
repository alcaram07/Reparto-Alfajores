@model VentaViewModel
@{
    ViewData["Title"] = "Nueva venta";
    ViewData["Accion"] = "Nuevo";
}

<div class="page-header">
    <h1><i class="bi bi-plus-circle me-2" style="color:var(--color-primary)"></i>Nueva venta</h1>
</div>

@await Html.PartialAsync("_FormVenta", Model)

<style>
    .recording-dot { display:inline-block; animation: blink 1s step-start infinite; }
    @@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0;} }
</style>

@section Scripts {
<script>
    const productPrices = @Html.Raw(Model.ProductosPreciosJson);
    const productNames = {};
    @foreach (var p in Model.Productos)
    {
        @:productNames[@p.Value] = '@p.Text.Replace("'", "\\'")';
    }
    window.initialItems = @Html.Raw(Model.ItemsJson);
</script>
<script src="~/js/venta-form.js"></script>
<script>
// ── Cargar por voz con IA ────────────────────────────────────────────────
let mediaRecorder = null;
let audioChunks = [];
let isRecording = false;

async function toggleRecording() {
    if (!isRecording) await startRecording();
    else stopRecording();
}

async function startRecording() {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];
        mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
        mediaRecorder.onstop = async () => {
            stream.getTracks().forEach(t => t.stop());
            const blob = new Blob(audioChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
            await enviarAudio(blob);
        };
        mediaRecorder.start();
        isRecording = true;
        document.getElementById('btnGrabarText').textContent = 'Detener';
        document.getElementById('btnGrabar').classList.replace('btn-primary', 'btn-danger');
        document.getElementById('recordingStatus').classList.remove('d-none');
        document.getElementById('vozAviso').classList.add('d-none');
    } catch (err) {
        mostrarAviso('No se pudo acceder al micrófono: ' + err.message, 'danger');
    }
}

function stopRecording() {
    if (mediaRecorder && isRecording) {
        mediaRecorder.stop();
        isRecording = false;
        document.getElementById('btnGrabarText').textContent = 'Grabar pedido';
        document.getElementById('btnGrabar').classList.replace('btn-danger', 'btn-primary');
        document.getElementById('recordingStatus').classList.add('d-none');
        document.getElementById('vozProcesando').classList.remove('d-none');
    }
}

function mostrarAviso(msg, tipo) {
    const el = document.getElementById('vozAviso');
    el.className = `mt-2 alert alert-${tipo} py-2 mb-0`;
    el.style.fontSize = '0.8rem';
    el.textContent = msg;
    el.classList.remove('d-none');
}

async function enviarAudio(blob) {
    const fd = new FormData();
    fd.append('audio', blob, 'pedido.webm');
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    try {
        const resp = await fetch('@Url.Action("InterpretarVoz", "Ventas")', {
            method: 'POST',
            headers: token ? { 'RequestVerificationToken': token } : {},
            body: fd
        });
        const data = await resp.json();
        document.getElementById('vozProcesando').classList.add('d-none');

        if (data.error) {
            mostrarAviso(data.error, 'warning');
            return;
        }

        (data.items || []).forEach(it => {
            const existing = items.findIndex(i => i.productId === it.productoId);
            if (existing >= 0) items[existing].qty += it.cantidad;
            else items.push({ productId: it.productoId, qty: it.cantidad, precio: it.precio, nombre: it.nombre });
        });
        renderItems();

        let msg = data.transcripcion ? `Escuché: "${data.transcripcion}"` : 'Pedido cargado.';
        if ((data.noEncontrados || []).length > 0) {
            msg += ' No encontré: ' + data.noEncontrados.join(', ') + '.';
        }
        mostrarAviso(msg, (data.noEncontrados || []).length > 0 ? 'warning' : 'success');
    } catch (err) {
        document.getElementById('vozProcesando').classList.add('d-none');
        mostrarAviso('Error procesando el audio: ' + err.message, 'danger');
    }
}
</script>
}
