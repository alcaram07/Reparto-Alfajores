@{
    var codigo = ViewBag.Codigo as int?;
    var esNoEncontrado = codigo == 404;
    ViewData["Title"] = esNoEncontrado ? "No encontrado" : "Error";
}

<div class="page-header">
    <h1>
        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
        @(esNoEncontrado ? "No encontrado" : "Ocurrió un error")
    </h1>
</div>

<div class="card">
    <div class="card-body text-center py-5">
        <i class="bi @(esNoEncontrado ? "bi-search" : "bi-exclamation-circle") text-danger"
           style="font-size: 3rem;"></i>

        @if (esNoEncontrado)
        {
            <h4 class="mt-3">Esta página no existe</h4>
            <p class="text-muted">
                Puede que el enlace esté mal escrito, o que lo que buscabas se haya eliminado.
            </p>
        }
        else
        {
            <h4 class="mt-3">Algo salió mal</h4>
            <p class="text-muted">Ocurrió un error al procesar la solicitud. Por favor intentá de nuevo.</p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house me-1"></i> Volver al inicio
        </a>

        @if (codigo.HasValue && !esNoEncontrado)
        {
            <div class="text-muted mt-4" style="font-size:0.8rem">Código @codigo</div>
        }
    </div>
</div>
